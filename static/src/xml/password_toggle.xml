<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="asset_management.PasswordToggleField">

        <div class="o_password_toggle_field">

            <input
                class="o_input"
                t-att-type="inputType"
                t-att-value="props.record.data[props.name] || ''"
                t-on-input="(ev) => props.record.update({
                    [props.name]: ev.target.value
                })"
            />

            <button
                type="button"
                class="o_password_toggle_button"
                t-on-click="togglePassword"
                tabindex="-1"
            >
                <i t-att-class="iconClass"/>
            </button>

        </div>

    </t>

</templates>