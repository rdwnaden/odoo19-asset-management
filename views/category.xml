<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_category_view_form" model="ir.ui.view">
        <field name="name">itsm.category.view.form</field>
        <field name="model">itsm.category</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_category_view_tree" model="ir.ui.view">
        <field name="name">itsm.category.view.tree</field>
        <field name="model">itsm.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="icon"/>
            </list>
        </field>
    </record>

    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Category List</field>
        <field name="res_model">itsm.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Asset Menu -->
    <menuitem id="menu_asset_category"
            name="Category"
            parent="menu_asset_configuration"
            action="category_action"
            sequence="30"/>

</odoo>
