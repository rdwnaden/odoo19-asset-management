<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_brands_view_form" model="ir.ui.view">
        <field name="name">itsm.brands.view.form</field>
        <field name="model">itsm.brands</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_brands_view_tree" model="ir.ui.view">
        <field name="name">itsm.brands.view.tree</field>
        <field name="model">itsm.brands</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="brands_action" model="ir.actions.act_window">
        <field name="name">Brands List</field>
        <field name="res_model">itsm.brands</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Asset Menu -->
    <menuitem id="menu_asset_brands"
            name="Brands"
            parent="menu_asset_configuration"
            action="brands_action"
            sequence="40"/>

</odoo>
