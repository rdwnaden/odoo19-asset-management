<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_location_view_form" model="ir.ui.view">
        <field name="name">itsm.location.view.form</field>
        <field name="model">itsm.location</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_location_view_tree" model="ir.ui.view">
        <field name="name">itsm.location.view.tree</field>
        <field name="model">itsm.location</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="location_action" model="ir.actions.act_window">
        <field name="name">Location List</field>
        <field name="res_model">itsm.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Asset Menu -->
    <menuitem id="menu_asset_location"
            name="Location"
            parent="menu_asset_configuration"
            action="location_action"
            sequence="50"/>

</odoo>
