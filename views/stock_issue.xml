<odoo>


    <record id="stock_issue_tree" model="ir.ui.view">
        <field name="name">asset.stock.issue.tree</field>
        <field name="model">asset.stock.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="stock_issue_form" model="ir.ui.view">
        <field name="name">asset.stock.issue.form</field>
        <field name="model">asset.stock.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_validate"
                        string="Validate"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'done'"/>
                <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Reference Number"/>
                        </h1>
                    </div>
                    <group>
                        <field name="date" readonly="state == 'done'"/>
                        <field name="used_by" widget="radio"/>
                        <field name="employee_id" invisible="used_by != 'employee'" required="used_by == 'employee'" options="{'no_open': True, 'no_create': True}"/>
                        <field name="division_id" invisible="used_by != 'division'" required="used_by == 'division'" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids" >
                                <list editable="bottom">
                                    <field name="item_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="qty" width="150"/>
                                    <field name="unit" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>


    <record id="stock_issue_action" model="ir.actions.act_window">
        <field name="name">Stock Out</field>
        <field name="res_model">asset.stock.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
    id="stock_issue_menu"
    name="Stock Out"
    parent="stock_action"
    action="stock_issue_action"
    sequence="30"/>

</odoo>