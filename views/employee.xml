<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_employee_view_form" model="ir.ui.view">
        <field name="name">itsm.employee.view.form</field>
        <field name="model">itsm.employee</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_employee_view_tree" model="ir.ui.view">
        <field name="name">itsm.employee.view.tree</field>
        <field name="model">itsm.employee</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="employee_action" model="ir.actions.act_window">
        <field name="name">Employee List</field>
        <field name="res_model">itsm.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Master Menu -->
    <menuitem id="menu_asset_configuration"
            name="Configuration"
            parent="menu_asset_root"
            sequence="100"/>


    <!-- Asset Menu -->
    <menuitem id="menu_asset_employee"
            name="Employee"
            parent="menu_asset_configuration"
            action="employee_action"
            sequence="10"/>

</odoo>
